# Python virtual environment
.venv/
venv/
ENV/
env/

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Environment variables & secrets (CRITICAL)
.env
.env.*
!.env.example

# Value Investors Club sessions and profiles
.vic_session/
.vic_profile/

# Logs and debug files
*.log

# Operating System specific files
.DS_Store
Thumbs.db

# IDE & Editor configurations
.idea/
.vscode/

# Output reports & run artifacts (keep folder tracked via .gitkeep)
reports/*
!reports/.gitkeep
